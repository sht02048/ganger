{
  "expo": {
    "name": "Ganger",
    "slug": "ganger",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#090909",
    "platforms": ["ios", "web"],
    "experiments": {
      "reactCompiler": true
    },
    "ios": {
      "supportsTablet": false
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Ganger 화면의 기기 연결 QR을 읽을 때 카메라를 써요.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/pretendard/dist/public/static/Pretendard-Regular.otf",
            "./node_modules/pretendard/dist/public/static/Pretendard-Medium.otf",
            "./node_modules/pretendard/dist/public/static/Pretendard-SemiBold.otf"
          ]
        }
      ],
      ["expo-splash-screen", { "backgroundColor": "#090909" }]
    ]
  }
}
