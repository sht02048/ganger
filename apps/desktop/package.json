{
  "name": "@ganger/desktop",
  "version": "0.5.0",
  "private": true,
  "description": "Desktop app (window, tray, notifications) for Ganger",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "vite build -c vite.main.config.ts && vite build -c vite.preload.config.ts && vite build -c vite.renderer.config.ts",
    "start": "electron .",
    "package": "node scripts/package.ts",
    "build:native": "node scripts/native-addon.ts",
    "smoke": "vitest run -c vitest.smoke.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "brand-assets": "node scripts/brand-assets.ts"
  },
  "dependencies": {
    "@ganger/api": "workspace:*",
    "@ganger/cli": "workspace:*",
    "@ganger/db": "workspace:*",
    "@ganger/log": "workspace:*",
    "@ganger/ui": "workspace:*",
    "@stylexjs/stylex": "0.19.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "use-intl": "4.15.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@ganger/app": "workspace:*",
    "@ganger/core": "workspace:*",
    "@stylexjs/unplugin": "0.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.2.3",
    "playwright-core": "1.65.0",
    "vite": "8.3.8"
  },
  "browserslist": [
    "chrome >= 123"
  ]
}
