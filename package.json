{
  "name": "ganger",
  "version": "0.6.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "build": "turbo run build",
    "bundle": "node scripts/bundle.ts",
    "release:mac": "node scripts/release-mac.ts",
    "dev": "node demo/src/desktop.ts",
    "dev:web": "node demo/src/main.ts",
    "dev:mobile": "node demo/src/mobile.ts",
    "check:colors": "node scripts/check-color-literals.ts",
    "check:lengths": "node scripts/check-style-lengths.ts",
    "smoke:web": "node scripts/smoke-web-prod.ts",
    "smoke:cli": "node scripts/smoke-cli.ts",
    "smoke:bundle": "node scripts/smoke-cli.ts --bundle",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "update:browser-times": "node scripts/update-browser-test-times.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "^24.19.2",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.21.0"
}
